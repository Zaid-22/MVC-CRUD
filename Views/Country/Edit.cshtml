@model MvcCrudProject.ViewModels.CountryViewModel
@{
    ViewData["Title"] = "Edit Country";
    ViewData["PageTitle"] = "Edit Country";
    ViewData["PageSubtitle"] = "Update country information";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Edit Country</h3>
    </div>
    <div class="block-content block-content-full">
        <div class="row">
            <div class="col-lg-8">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
                    <input type="hidden" asp-for="CountryId" />
                    <div class="mb-4">
                        <label asp-for="CountryName" class="form-label">Country Name</label>
                        <input asp-for="CountryName" class="form-control" />
                        <span asp-validation-for="CountryName" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="RegionId" class="form-label">Region</label>
                        <select asp-for="RegionId" asp-items="ViewBag.RegionId" class="form-select">
                            <option value="">-- Select Region --</option>
                        </select>
                        <span asp-validation-for="RegionId" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i> Update</button>
                        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
