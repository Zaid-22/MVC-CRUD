@model MvcCrudProject.ViewModels.CountryViewModel
@{
    ViewData["Title"] = "Country Details";
    ViewData["PageTitle"] = "Country Details";
    ViewData["PageSubtitle"] = "View country information";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Country Details</h3>
    </div>
    <div class="block-content block-content-full">
        <dl class="row mb-0">
            <dt class="col-sm-3">Country ID</dt>
            <dd class="col-sm-9">@Model.CountryId</dd>
            <dt class="col-sm-3">Country Name</dt>
            <dd class="col-sm-9 fw-semibold">@Model.CountryName</dd>
            <dt class="col-sm-3">Region</dt>
            <dd class="col-sm-9">@Model.RegionName</dd>
        </dl>
        <hr class="my-4">
        <a asp-action="Edit" asp-route-id="@Model.CountryId" class="btn btn-alt-warning"><i class="fa fa-pencil-alt me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back to List</a>
    </div>
</div>
