@model MvcCrudProject.ViewModels.GalaxyViewModel
@{
    ViewData["Title"] = "Galaxy Details";
    ViewData["PageTitle"] = "Galaxy Details";
    ViewData["PageSubtitle"] = "View galaxy information";
}

<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Galaxy Details</h3>
    </div>
    <div class="block-content">
        <dl class="row">
            <dt class="col-sm-3 fw-semibold">Galaxy ID</dt>
            <dd class="col-sm-9">@Model.GalaxyId</dd>

            <dt class="col-sm-3 fw-semibold">Galaxy Name</dt>
            <dd class="col-sm-9">@Model.GalaxyName</dd>
        </dl>
        <hr>
        <a asp-action="Edit" asp-route-id="@Model.GalaxyId" class="btn btn-alt-warning">
            <i class="fa fa-pencil-alt me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-alt-secondary ms-1">
            <i class="fa fa-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>
