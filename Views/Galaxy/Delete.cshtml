@model MvcCrudProject.ViewModels.GalaxyViewModel
@{
    ViewData["Title"] = "Delete Galaxy";
    ViewData["PageTitle"] = "Delete Galaxy";
    ViewData["PageSubtitle"] = "Confirm deletion";
}

<div class="block block-rounded border-danger">
    <div class="block-header block-header-default">
        <h3 class="block-title text-danger">
            <i class="fa fa-exclamation-triangle me-1"></i> Confirm Delete
        </h3>
    </div>
    <div class="block-content">
        <p class="fw-semibold">Are you sure you want to delete the following Galaxy?</p>
        <dl class="row">
            <dt class="col-sm-3 fw-semibold">Galaxy ID</dt>
            <dd class="col-sm-9">@Model.GalaxyId</dd>

            <dt class="col-sm-3 fw-semibold">Galaxy Name</dt>
            <dd class="col-sm-9">@Model.GalaxyName</dd>
        </dl>
        <hr>
        <form asp-action="Delete">
            <input type="hidden" asp-for="GalaxyId" />
            <button type="submit" class="btn btn-danger">
                <i class="fa fa-trash me-1"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-alt-secondary ms-1">
                <i class="fa fa-times me-1"></i> Cancel
            </a>
        </form>
    </div>
</div>
