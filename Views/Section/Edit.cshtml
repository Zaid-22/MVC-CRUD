@model MvcCrudProject.ViewModels.SectionViewModel
@{
    ViewData["Title"] = "Edit Section";
    ViewData["PageTitle"] = "Edit Section";
    ViewData["PageSubtitle"] = "Update section information";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Edit Section</h3>
    </div>
    <div class="block-content block-content-full">
        <div class="row">
            <div class="col-lg-8">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
                    <input type="hidden" asp-for="SectionId" />
                    <div class="mb-4">
                        <label asp-for="SectionName" class="form-label">Section Name</label>
                        <input asp-for="SectionName" class="form-control" />
                        <span asp-validation-for="SectionName" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="DepartmentId" class="form-label">Department</label>
                        <select asp-for="DepartmentId" asp-items="ViewBag.DepartmentId" class="form-select">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i> Update</button>
                        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
