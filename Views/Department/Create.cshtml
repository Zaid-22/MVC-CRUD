@model MvcCrudProject.ViewModels.DepartmentViewModel
@{
    ViewData["Title"] = "Add Department";
    ViewData["PageTitle"] = "Add Department";
    ViewData["PageSubtitle"] = "Create a new department entry";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Add Department</h3>
    </div>
    <div class="block-content block-content-full">
        <div class="row">
            <div class="col-lg-8">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
                    <div class="mb-4">
                        <label asp-for="DepartmentName" class="form-label">Department Name</label>
                        <input asp-for="DepartmentName" class="form-control" placeholder="Enter department name" />
                        <span asp-validation-for="DepartmentName" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="BranchId" class="form-label">Branch</label>
                        <select asp-for="BranchId" asp-items="ViewBag.BranchId" class="form-select">
                            <option value="">-- Select Branch --</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i> Save</button>
                        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
