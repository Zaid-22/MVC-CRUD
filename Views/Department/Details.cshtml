@model MvcCrudProject.ViewModels.DepartmentViewModel
@{
    ViewData["Title"] = "Department Details";
    ViewData["PageTitle"] = "Department Details";
    ViewData["PageSubtitle"] = "View department information";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Department Details</h3>
    </div>
    <div class="block-content block-content-full">
        <dl class="row mb-0">
            <dt class="col-sm-3">Department ID</dt>
            <dd class="col-sm-9">@Model.DepartmentId</dd>
            <dt class="col-sm-3">Department Name</dt>
            <dd class="col-sm-9 fw-semibold">@Model.DepartmentName</dd>
            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.BranchName</dd>
        </dl>
        <hr class="my-4">
        <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn btn-alt-warning"><i class="fa fa-pencil-alt me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back to List</a>
    </div>
</div>
