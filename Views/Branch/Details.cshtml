@model MvcCrudProject.ViewModels.BranchViewModel
@{
    ViewData["Title"] = "Branch Details";
    ViewData["PageTitle"] = "Branch Details";
    ViewData["PageSubtitle"] = "View branch information";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Branch Details</h3>
    </div>
    <div class="block-content block-content-full">
        <dl class="row mb-0">
            <dt class="col-sm-3">Branch ID</dt>
            <dd class="col-sm-9">@Model.BranchId</dd>
            <dt class="col-sm-3">Branch Name</dt>
            <dd class="col-sm-9 fw-semibold">@Model.BranchName</dd>
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.CompanyName</dd>
            <dt class="col-sm-3">Area</dt>
            <dd class="col-sm-9">@Model.AreaName</dd>
        </dl>
        <hr class="my-4">
        <a asp-action="Edit" asp-route-id="@Model.BranchId" class="btn btn-alt-warning"><i class="fa fa-pencil-alt me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back to List</a>
    </div>
</div>
