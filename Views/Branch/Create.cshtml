@model MvcCrudProject.ViewModels.BranchViewModel
@{
    ViewData["Title"] = "Add Branch";
    ViewData["PageTitle"] = "Add Branch";
    ViewData["PageSubtitle"] = "Create a new branch entry";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Add Branch</h3>
    </div>
    <div class="block-content block-content-full">
        <div class="row">
            <div class="col-lg-8">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
                    <div class="mb-4">
                        <label asp-for="BranchName" class="form-label">Branch Name</label>
                        <input asp-for="BranchName" class="form-control" placeholder="Enter branch name" />
                        <span asp-validation-for="BranchName" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="CompanyId" class="form-label">Company</label>
                        <select asp-for="CompanyId" asp-items="ViewBag.CompanyId" class="form-select">
                            <option value="">-- Select Company --</option>
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="AreaId" class="form-label">Area</label>
                        <select asp-for="AreaId" asp-items="ViewBag.AreaId" class="form-select">
                            <option value="">-- Select Area --</option>
                        </select>
                        <span asp-validation-for="AreaId" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i> Save</button>
                        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
