@model IEnumerable<MvcCrudProject.ViewModels.BranchViewModel>
@{
    ViewData["Title"] = "Branches";
    ViewData["PageTitle"] = "Branches";
    ViewData["PageSubtitle"] = "Manage all branches";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">All Branches</h3>
        <div class="block-options">
            <a asp-action="Create" class="btn btn-sm btn-primary"><i class="fa fa-plus me-1"></i> Add New</a>
        </div>
    </div>
    <div class="block-content block-content-full overflow-x-auto">
        <table class="table table-bordered table-striped table-vcenter js-dataTable-full">
            <thead>
                <tr>
                    <th class="text-center" style="width:60px">#</th>
                    <th>Branch Name</th>
                    <th>Company</th>
                    <th>Area</th>
                    <th class="text-center" style="width:160px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fs-sm">@item.BranchId</td>
                        <td class="fw-semibold fs-sm">@item.BranchName</td>
                        <td class="fs-sm">@item.CompanyName</td>
                        <td class="fs-sm">@item.AreaName</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.BranchId" class="btn btn-sm btn-alt-warning me-1"><i class="fa fa-pencil-alt"></i></a>
                            <a asp-action="Details" asp-route-id="@item.BranchId" class="btn btn-sm btn-alt-info me-1"><i class="fa fa-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.BranchId" class="btn btn-sm btn-alt-danger"><i class="fa fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
