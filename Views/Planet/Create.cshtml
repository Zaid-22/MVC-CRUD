@model MvcCrudProject.ViewModels.PlanetViewModel
@{
    ViewData["Title"] = "Add Planet";
    ViewData["PageTitle"] = "Add Planet";
    ViewData["PageSubtitle"] = "Create a new planet entry";
}

<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Add Planet</h3>
    </div>
    <div class="block-content block-content-full">
        <div class="row">
            <div class="col-lg-8">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                    <div class="mb-4">
                        <label asp-for="PlanetName" class="form-label"></label>
                        <input asp-for="PlanetName" class="form-control" placeholder="Enter planet name" />
                        <span asp-validation-for="PlanetName" class="text-danger fs-sm"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="GalaxyId" class="form-label"></label>
                        <select asp-for="GalaxyId" asp-items="ViewBag.GalaxyId" class="form-select">
                            <option value="">-- Select Galaxy --</option>
                        </select>
                        <span asp-validation-for="GalaxyId" class="text-danger fs-sm"></span>
                    </div>

                    <div class="mb-4">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i> Save</button>
                        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
