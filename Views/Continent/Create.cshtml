@model MvcCrudProject.ViewModels.ContinentViewModel
@{
    ViewData["Title"] = "Add Continent";
    ViewData["PageTitle"] = "Add Continent";
    ViewData["PageSubtitle"] = "Create a new continent entry";
}

<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Add Continent</h3>
    </div>
    <div class="block-content block-content-full">
        <div class="row">
            <div class="col-lg-8">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
                    <div class="mb-4">
                        <label asp-for="ContinentName" class="form-label">Continent Name</label>
                        <input asp-for="ContinentName" class="form-control" placeholder="Enter continent name" />
                        <span asp-validation-for="ContinentName" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="PlanetId" class="form-label">Planet</label>
                        <select asp-for="PlanetId" asp-items="ViewBag.PlanetId" class="form-select">
                            <option value="">-- Select Planet --</option>
                        </select>
                        <span asp-validation-for="PlanetId" class="text-danger fs-sm"></span>
                    </div>
                    <div class="mb-4">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i> Save</button>
                        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
