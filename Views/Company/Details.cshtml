@model MvcCrudProject.ViewModels.CompanyViewModel
@{
    ViewData["Title"] = "Company Details";
    ViewData["PageTitle"] = "Company Details";
    ViewData["PageSubtitle"] = "View company information";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Company Details</h3>
    </div>
    <div class="block-content block-content-full">
        <dl class="row mb-0">
            <dt class="col-sm-3">Company ID</dt>
            <dd class="col-sm-9">@Model.CompanyId</dd>
            <dt class="col-sm-3">Company Name</dt>
            <dd class="col-sm-9 fw-semibold">@Model.CompanyName</dd>
        </dl>
        <hr class="my-4">
        <a asp-action="Edit" asp-route-id="@Model.CompanyId" class="btn btn-alt-warning"><i class="fa fa-pencil-alt me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back to List</a>
    </div>
</div>
