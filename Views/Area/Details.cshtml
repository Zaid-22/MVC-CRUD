@model MvcCrudProject.ViewModels.AreaViewModel
@{
    ViewData["Title"] = "Area Details";
    ViewData["PageTitle"] = "Area Details";
    ViewData["PageSubtitle"] = "View area information";
}
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Area Details</h3>
    </div>
    <div class="block-content block-content-full">
        <dl class="row mb-0">
            <dt class="col-sm-3">Area ID</dt>
            <dd class="col-sm-9">@Model.AreaId</dd>
            <dt class="col-sm-3">Area Name</dt>
            <dd class="col-sm-9 fw-semibold">@Model.AreaName</dd>
            <dt class="col-sm-3">City</dt>
            <dd class="col-sm-9">@Model.CityName</dd>
        </dl>
        <hr class="my-4">
        <a asp-action="Edit" asp-route-id="@Model.AreaId" class="btn btn-alt-warning"><i class="fa fa-pencil-alt me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-alt-secondary ms-1"><i class="fa fa-arrow-left me-1"></i> Back to List</a>
    </div>
</div>
